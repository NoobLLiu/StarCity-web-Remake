# 玩家门户 API 基地址（生产环境直连插件 HTTP，开发环境走 Vite 代理）
VITE_API_BASE=/api

# 开发环境 Vite 代理目标（StarCityBridge 插件 HTTP 服务）
# 形如 http://127.0.0.1:8083 或 http://your-mc-server:8083
VITE_DEV_PROXY_TARGET=http://localhost:8083

# 管理后台令牌（敏感信息，请勿硬编码进仓库；推荐通过 .env.local 注入）
VITE_ADMIN_TOKEN=

# 站点标题
VITE_SITE_TITLE=StarCity
